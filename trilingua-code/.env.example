APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Timeout ladder (also enforced by deployment:validate-timeouts at startup):
# PYTHON_SERVICE_TIMEOUT < TRANSLATION_JOB_TIMEOUT < QUEUE_WORKER_TIMEOUT <
# DB_QUEUE_RETRY_AFTER < RECONCILE_PROCESSING_TIMEOUT.
DB_QUEUE_RETRY_AFTER=1800

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=translations

# ── Google OAuth (Sign in with Google) ────────────────────────────────────────
# Create an OAuth 2.0 client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Translation Provider Configuration ──────────────────────────────────────
# GPT-OSS translates first. Gemini takes over after GPT-OSS exhausts its
# retries and remains the analysis/quality-review provider.
TRANSLATION_PROVIDER=gptoss
TRANSLATION_FALLBACK_PROVIDER=gemini
ANALYSIS_PROVIDER=gemini
# Analysis falls back to local Ollama when Gemini is unavailable.
ANALYSIS_FALLBACK_PROVIDER=ollama
# Pace Gemini analysis/review so bursts stay inside the free-tier RPM window.
ANALYSIS_PRIMARY_MIN_INTERVAL_SECONDS=5
TRANSLATION_ANALYZER_MODE=merged
TRANSLATION_BATCHED_REVIEW=true
QUALITY_REVIEW_BLIND=true

# GPT-OSS via Ollama Cloud
OLLAMA_CLOUD_URL=http://localhost:11434/api/chat
# Required only when OLLAMA_CLOUD_URL points directly to https://ollama.com/api/chat.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:20b-cloud

# Google Gemini (primary document-analysis and quality-review provider)
# Get your key at: https://aistudio.google.com/app/apikey
# gemini-3.5-flash-lite's free tier (~500 req/day) is far more forgiving than
# the larger 3.x flash models (~20 req/day); use a billed project to lift caps.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_ATTEMPTS=3
GEMINI_ANALYSIS_MAX_ATTEMPTS=3
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_ANALYSIS_MAX_OUTPUT_TOKENS=2048
TRANSLATION_PRIMARY_COOLDOWN_SECONDS=300
TRANSLATION_PROMPT_VERSION=2026-09-reference-gemini-v2
TRANSLATION_MAX_CONCURRENT=2
TRANSLATION_BUSY_WAIT_SECONDS=30
DOCUMENT_QUEUE_WORKERS=2
MODEL_SERVICE_RELOAD=false
GPTOSS_MAX_ATTEMPTS=3
GPTOSS_REQUEST_TIMEOUT_SECONDS=180
# Shared process-wide GPT-OSS capacity for document batches. Two active
# documents fairly divide these eight slots; Gemini fallback stays serialized.
GPTOSS_TRANSLATION_SLOTS=8
# 0 uses Ollama's model default. Empty replies retry at 8192 then 16384.
GPTOSS_MAX_OUTPUT_TOKENS=0
GPTOSS_EMPTY_RETRY_OUTPUT_TOKENS=16384
TRANSLATION_FALLBACK_COOLDOWN_SECONDS=60
GPTOSS_MIN_INTERVAL_SECONDS=0
GEMINI_FALLBACK_CONCURRENCY=1
TRANSLATION_CONCURRENCY=8

# Analysis falls back to Ollama while Gemini is unavailable/rate limited.
# Use a model capable of filling the merged document analysis JSON structure.
OLLAMA_ANALYSIS_MODEL=gpt-oss:20b-cloud

# ── Future Provider Configuration (Stubs) ────────────────────────────────────
# These providers are not yet implemented. Uncomment when ready to implement.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-chat

# Python AI Engine
PYTHON_SERVICE_URL=http://127.0.0.1:5000
PYTHON_SERVICE_TIMEOUT=1200
# Illuminate job $timeout for one translation attempt.
TRANSLATION_JOB_TIMEOUT=1300
# queue:listen/queue:work --timeout (must match the launch scripts).
QUEUE_WORKER_TIMEOUT=1500
# translations:reconcile --processing-timeout and queue:check-stale --threshold.
RECONCILE_PROCESSING_TIMEOUT=2100
QUEUE_CHECK_STALE_THRESHOLD=2100
# Shared secret sent as X-Service-Token to the python service. The python engine
# reads the same variable name. Deploy both sides together; artisan (tests) keep
# it empty so it is not sent. REQUIRED and non-empty when APP_ENV=production:
# the python service refuses to start without it. MODEL_SERVICE_TOKEN is read
# only as a legacy local fallback and must not be used to configure a deploy.
PYTHON_SERVICE_TOKEN=

# ── Durable storage fallback ──────────────────────────────────────────────────
# Enable only once the encrypted persistent volume / second bucket exists.
# Translated output goes to the PRIMARY backend with retries, then here.
FALLBACK_STORAGE_ENABLED=false
FALLBACK_STORAGE_DRIVER=local
FALLBACK_STORAGE_PATH="${STORAGE_PATH}/app/private/translations"

# ── Upload protection ─────────────────────────────────────────────────────────
TRANSLATION_MAX_DAILY_FILES=25
TRANSLATION_MAX_DAILY_BYTES=262144000
