# Paste into the Laravel application's Cloud environment settings.
# Fill blank values using Cloud secrets; never commit a populated copy.
APP_NAME=TriLingua
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Keep the existing Supabase PostgreSQL database; do not attach a replacement.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

QUEUE_CONNECTION=database
PYTHON_DOCUMENT_JOBS=true
PYTHON_SERVICE_TIMEOUT=1200
TRANSLATION_JOB_TIMEOUT=1300
QUEUE_WORKER_TIMEOUT=1500
DB_QUEUE_RETRY_AFTER=1800
RECONCILE_PROCESSING_TIMEOUT=2100
RECONCILE_WAITING_TIMEOUT=7200
QUEUE_CHECK_STALE_THRESHOLD=2100

# HTTPS URL of the separately deployed Python application.
PYTHON_SERVICE_URL=
# Generate one random secret (at least 32 characters) and set it on both apps.
PYTHON_SERVICE_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=trailingua
FALLBACK_STORAGE_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Configure real SMTP for password resets; log mail does not deliver email.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TriLingua
