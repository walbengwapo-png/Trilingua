# Paste into the Python application's Cloud environment settings.
APP_ENV=production
PYTHON_SERVICE_TOKEN=
TRANSLATION_PROVIDER=gptoss
TRANSLATION_FALLBACK_PROVIDER=gemini
ANALYSIS_PROVIDER=gemini
ANALYSIS_FALLBACK_PROVIDER=ollama
OLLAMA_CLOUD_URL=https://ollama.com/api/chat
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:20b-cloud
OLLAMA_ANALYSIS_MODEL=gpt-oss:20b-cloud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TRANSLATION_ANALYZER_MODE=merged
TRANSLATION_BATCHED_REVIEW=true
QUALITY_REVIEW_BLIND=true
ANALYSIS_PRIMARY_MIN_INTERVAL_SECONDS=5
TRANSLATION_MAX_CONCURRENT=1
DOCUMENT_MAX_CONCURRENT=1
TRANSLATION_THREADPOOL_SIZE=4
TRANSLATION_UNIT_PIPELINE=false
WEB_CONCURRENCY=1
MODEL_SERVICE_RELOAD=false
ALLOW_PROVIDER_WARMUP=false
