diff --git a/trilingua-code/tests/Feature/HybridPdfPartialOutputTest.php b/trilingua-code/tests/Feature/HybridPdfPartialOutputTest.php
new file mode 100644
index 0000000..f9b8ac9
--- /dev/null
+++ b/trilingua-code/tests/Feature/HybridPdfPartialOutputTest.php
@@ -0,0 +1,79 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Exceptions\TranslationException;
+use App\Models\TranslationHistory;
+use App\Models\User;
+use App\Services\Admin\ReviewService;
+use App\Services\BlockService;
+use App\Services\StorageService;
+use App\Services\Translation\CompletedDownloadResolver;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class HybridPdfPartialOutputTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_all_held_envelope_survives_history_status_review_and_download(): void
+    {
+        $user = User::factory()->create(['is_admin' => true]);
+        $history = TranslationHistory::create([
+            'user_id' => $user->id, 'translation_type' => 'document',
+            'original_filename' => 'scan.pdf', 'translated_filename' => 'scan_untranslated.pdf',
+            'source_language' => 'English', 'target_language' => 'Cebuano',
+            'status' => 'completed', 'review_status' => 'pending',
+            'storage_backend' => StorageService::BACKEND_LOCAL, 'storage_path' => 'output.pdf',
+        ]);
+        $sidecar = ['version' => 3, 'blocks' => [],
+            'content_summary' => ['status' => 'untranslated', 'translated' => 0, 'held' => 1, 'passthrough' => 0],
+            'extraction' => ['warnings' => ['Original region retained: ocr_acceptance_hold.']],
+            'render_plan' => ['version' => 1, 'regions' => [
+                ['page' => 0, 'source_kind' => 'raster', 'bbox' => [0, 0, 100, 100],
+                    'status' => 'held', 'reason' => 'ocr_acceptance_hold'],
+            ]],
+        ];
+        $this->assertSame(0, app(BlockService::class)->persistBlocks($history, [], $sidecar));
+        $history->refresh();
+        $this->assertSame($sidecar, $history->sidecar);
+        $this->assertSame(0, $history->blocks()->count());
+        $storage = \Mockery::mock(StorageService::class);
+        $storage->shouldReceive('exists')->andReturn(StorageService::PRESENCE_PRESENT);
+        $this->app->instance(StorageService::class, $storage);
+        $payload = app(CompletedDownloadResolver::class)->resolve($history);
+        $this->assertSame('untranslated', $payload['content_summary']['status']);
+        $this->assertSame('scan_untranslated.pdf', $payload['download_filename']);
+        $this->assertNotEmpty($payload['warnings']);
+        $this->actingAs($user)->get("/history/{$history->id}")->assertOk()->assertJsonPath('sidecar.content_summary.status', 'untranslated');
+        $this->get(route('history.view', $history->id))->assertOk()->assertSee('held regions retain the original language');
+        $this->get(route('admin.review.show', $history->id))->assertOk()->assertSee('ocr_acceptance_hold');
+        $this->get('/documents')->assertOk()->assertSee('held regions retain their original language')->assertDontSee('100% Complete');
+        $this->expectException(TranslationException::class);
+        app(ReviewService::class)->verifyDocument($history->id, $user->id);
+    }
+
+    public function test_legacy_empty_blocks_do_not_discard_existing_sidecar(): void
+    {
+        $user = User::factory()->create();
+        $history = TranslationHistory::create(['user_id' => $user->id, 'translation_type' => 'document',
+            'status' => 'completed', 'source_language' => 'English', 'target_language' => 'Cebuano', 'sidecar' => ['version' => 2, 'blocks' => []]]);
+        app(BlockService::class)->persistBlocks($history, []);
+        $this->assertSame(2, $history->refresh()->sidecar['version']);
+    }
+
+    public function test_partial_extraction_is_not_counted_as_complete_document_volume(): void
+    {
+        $user = User::factory()->create();
+        $history = TranslationHistory::create(['user_id' => $user->id, 'translation_type' => 'document',
+            'status' => 'completed', 'source_language' => 'English', 'target_language' => 'Cebuano']);
+        app(BlockService::class)->persistBlocks($history, [
+            ['block_index' => 0, 'source_text' => 'Known native words', 'ai_translated_text' => 'Fixed translation'],
+        ], ['content_summary' => ['status' => 'partial', 'translated' => 1, 'held' => 1]]);
+        $this->assertNull($history->refresh()->document_word_count);
+        if ($history->source_word_metadata !== null) {
+            $this->assertNull($history->source_word_metadata['count']);
+            $this->assertSame('partial', $history->source_word_metadata['completeness']);
+        }
+    }
+}
diff --git a/trilingua-code/tests/browser/hybrid-pdf-partial.test.mjs b/trilingua-code/tests/browser/hybrid-pdf-partial.test.mjs
new file mode 100644
index 0000000..2368352
--- /dev/null
+++ b/trilingua-code/tests/browser/hybrid-pdf-partial.test.mjs
@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict';
+import {test,before,after} from 'node:test';
+import {createRequire} from 'node:module';
+import {readFileSync} from 'node:fs';
+import {execFileSync} from 'node:child_process';
+import {resolve,dirname} from 'node:path';
+import {fileURLToPath} from 'node:url';
+
+const require=createRequire(import.meta.url);
+const {chromium}=require(process.env.TRILINGUA_PLAYWRIGHT_MODULE || 'playwright');
+const root=resolve(dirname(fileURLToPath(import.meta.url)),'../..');
+let browser;
+before(async()=>{browser=await chromium.launch({channel:'chrome',headless:true});});
+after(async()=>{await browser?.close();});
+
+function translationHtml(){
+    const source=readFileSync(resolve(root,'resources/views/translation.blade.php'),'utf8');
+    const body=source.slice(source.indexOf("@section('content')")+"@section('content')".length,source.lastIndexOf('@endsection'));
+    const capabilities={languages:['English','Cebuano','Filipino'],modes:['fast','balanced','thorough'],
+        text_max_chars:5000,formats:['pdf'],accept:'.pdf',max_upload_bytes:10_000_000,pdf_column_modes:['auto','left','right']};
+    return execFileSync('php',['-r',`require 'vendor/autoload.php'; $app=require 'bootstrap/app.php';
+        $app->make(Illuminate\\Contracts\\Console\\Kernel::class)->bootstrap();
+        $input=json_decode(file_get_contents('php://stdin'),true);echo Illuminate\\Support\\Facades\\Blade::render($input['source'],['capabilities'=>$input['capabilities']]);`],
+        {cwd:root,input:JSON.stringify({source:body,capabilities}),env:{...process.env,APP_ENV:'testing',DB_CONNECTION:'sqlite',DB_DATABASE:':memory:',DB_URL:''}}).toString();
+}
+
+for(const status of ['partial','untranslated']){
+    test(`actual completion UI labels ${status} and original-language holds`,async()=>{
+        const page=await browser.newPage();const errors=[];page.on('pageerror',e=>errors.push(e.message));
+        const summary={status,translated:status==='partial'?1:0,held:2,passthrough:0};
+        const html=translationHtml();
+        await page.route('**/*',async route=>{
+            const url=new URL(route.request().url());
+            if(url.pathname==='/')return route.fulfill({contentType:'text/html',body:`<meta name="csrf-token" content="test">${html}`});
+            if(url.pathname==='/translate')return route.fulfill({json:{status:'processing',job_id:'fixed-ui-job'}});
+            if(url.pathname==='/translate/status/fixed-ui-job')return route.fulfill({json:{status:'completed',
+                content_summary:summary,warnings:['Held regions retain original content.'],download_url:'/download',download_filename:`result_${status}.pdf`}});
+            return route.abort();
+        });
+        try{
+            await page.goto('https://hybrid.test/');
+            await page.locator('#file-input').setInputFiles(resolve(root,'tests/testPDFs/M1_Q1_ENGLISH 8.pdf'));
+            await page.locator('#translate-btn').click();
+            await page.waitForFunction(()=>document.querySelector('#output-text').textContent.includes('held regions'));
+            const text=await page.locator('#output-text').innerText();
+            assert.match(text,new RegExp(status));assert.match(text,/original language/);
+            assert.match(await page.locator('#workbook-warning').innerText(),/original content/);
+            assert.equal(await page.locator('#download-link').getAttribute('download'),`result_${status}.pdf`);
+            assert.doesNotMatch(text,/Your document has been translated/);assert.deepEqual(errors,[]);
+        }finally{await page.close();}
+    });
+}
